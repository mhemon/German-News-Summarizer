DEBUG=True
API_TITLE=German News Summarizer API
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional OpenAI-compatible provider (leave blank to use local fallback summarization)
OPENAI_API_KEY=
